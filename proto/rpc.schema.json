{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Chiloute/vpn-tui/proto/rpc.schema.json",
  "title": "vpn-tuid JSON-RPC 2.0 contract (NDJSON, one message per line, max 64 KiB)",
  "description": "Entry points: #/$defs/request, #/$defs/response, #/$defs/event_notification. Secrets only travel in up.params.secrets.",
  "$defs": {
    "error_codes": {
      "description": "-32700 parse error; -32600 invalid request; -32601 method not found; -32602 invalid params; -32001 forbidden; -32002 too_large; -32003 not_implemented; -32004 busy; -32005 not_found; -32006 import_rejected; -32603 connect_failed.",
      "enum": [-32700, -32600, -32601, -32602, -32603, -32001, -32002, -32003, -32004, -32005, -32006]
    },
    "profile_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,31}$" },
    "profile_name": { "type": "string", "minLength": 1, "maxLength": 64 },
    "profile_type": { "enum": ["openvpn", "wireguard"] },
    "cidr": { "type": "string", "maxLength": 49, "pattern": "^[0-9a-fA-F:.]+/[0-9]{1,3}$" },
    "cidr_list": { "type": "array", "maxItems": 1024, "items": { "$ref": "#/$defs/cidr" } },
    "ipv4": { "type": "string", "pattern": "^((25[0-5]|2[0-4][0-9]|1?[0-9]?[0-9])\\.){3}(25[0-5]|2[0-4][0-9]|1?[0-9]?[0-9])$" },
    "timestamp": { "type": "string", "format": "date-time", "maxLength": 40 },
    "state": { "enum": ["disarmed", "armed", "reconnecting", "locked"] },
    "event_kind": { "enum": ["up", "down", "drop", "reconnect", "lock", "panic_off", "reconcile", "scope_learned", "peer_rejected", "error"] },
    "tags": { "type": "array", "maxItems": 8, "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z0-9-]{1,16}$" } },
    "color": { "type": "string", "pattern": "^base0[0-9A-F]$", "description": "Base16 color name of the ilovetui theme." },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cidrs", "exclude", "learned"],
      "properties": {
        "cidrs": { "$ref": "#/$defs/cidr_list" },
        "exclude": { "$ref": "#/$defs/cidr_list" },
        "learned": { "$ref": "#/$defs/cidr_list" }
      }
    },
    "killswitch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "allow_internet", "block_ipv6"],
      "properties": {
        "enabled": { "type": "boolean" },
        "allow_internet": { "type": "boolean" },
        "block_ipv6": { "type": "boolean" }
      }
    },
    "dns": {
      "type": "object",
      "additionalProperties": false,
      "required": ["servers", "force"],
      "properties": {
        "servers": { "type": "array", "maxItems": 8, "items": { "type": "string", "maxLength": 45, "pattern": "^[0-9a-fA-F:.]+$" } },
        "force": { "type": "boolean" }
      }
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "type", "tags", "color", "scope", "killswitch", "dns", "has_secrets"],
      "properties": {
        "id": { "$ref": "#/$defs/profile_id" },
        "name": { "$ref": "#/$defs/profile_name" },
        "type": { "$ref": "#/$defs/profile_type" },
        "tags": { "$ref": "#/$defs/tags" },
        "color": { "$ref": "#/$defs/color" },
        "scope": { "$ref": "#/$defs/scope" },
        "killswitch": { "$ref": "#/$defs/killswitch" },
        "dns": { "$ref": "#/$defs/dns" },
        "has_secrets": { "type": "boolean" }
      }
    },
    "secrets": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["username", "password"],
          "properties": {
            "username": { "type": "string", "minLength": 1, "maxLength": 256 },
            "password": { "type": "string", "maxLength": 1024 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["private_key"],
          "properties": {
            "private_key": { "type": "string", "pattern": "^[A-Za-z0-9+/]{43}=$", "minLength": 44, "maxLength": 44 },
            "preshared_key": { "type": "string", "pattern": "^[A-Za-z0-9+/]{43}=$", "minLength": 44, "maxLength": 44 }
          }
        }
      ]
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["time", "profile", "state", "kind", "detail"],
      "properties": {
        "time": { "$ref": "#/$defs/timestamp" },
        "profile": { "oneOf": [{ "$ref": "#/$defs/profile_id" }, { "type": "null" }] },
        "state": { "$ref": "#/$defs/state" },
        "kind": { "$ref": "#/$defs/event_kind" },
        "detail": { "type": "string", "maxLength": 1024 }
      }
    },

    "params_empty": { "type": "object", "additionalProperties": false, "maxProperties": 0 },
    "result_ack": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ok"],
      "properties": { "ok": { "const": true } }
    },

    "params_status": { "$ref": "#/$defs/params_empty" },
    "result_status": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "profile", "killswitch", "lhost", "scope", "since", "reconnect", "interface", "rx_bytes", "tx_bytes"],
      "properties": {
        "state": { "$ref": "#/$defs/state" },
        "profile": { "oneOf": [{ "$ref": "#/$defs/profile_id" }, { "type": "null" }] },
        "killswitch": { "type": "boolean" },
        "lhost": { "oneOf": [{ "$ref": "#/$defs/ipv4" }, { "type": "null" }] },
        "scope": { "$ref": "#/$defs/cidr_list" },
        "since": { "oneOf": [{ "$ref": "#/$defs/timestamp" }, { "type": "null" }] },
        "reconnect": {
          "type": "object",
          "additionalProperties": false,
          "required": ["attempt", "max"],
          "properties": {
            "attempt": { "type": "integer", "minimum": 0 },
            "max": { "type": "integer", "minimum": 0 }
          }
        },
        "interface": { "type": ["string", "null"], "maxLength": 15 },
        "rx_bytes": { "type": "integer", "minimum": 0 },
        "tx_bytes": { "type": "integer", "minimum": 0 }
      }
    },

    "params_list": { "$ref": "#/$defs/params_empty" },
    "result_list": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profiles"],
      "properties": { "profiles": { "type": "array", "items": { "$ref": "#/$defs/profile" } } }
    },

    "params_up": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": {
        "id": { "$ref": "#/$defs/profile_id" },
        "secrets": { "$ref": "#/$defs/secrets" }
      }
    },
    "result_up": { "$ref": "#/$defs/result_ack" },

    "params_down": { "$ref": "#/$defs/params_empty" },
    "result_down": { "$ref": "#/$defs/result_ack" },

    "params_panic_off": { "$ref": "#/$defs/params_empty" },
    "result_panic_off": { "$ref": "#/$defs/result_ack" },

    "params_profile_import": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "name", "content"],
      "properties": {
        "type": { "$ref": "#/$defs/profile_type" },
        "name": { "$ref": "#/$defs/profile_name" },
        "id": { "$ref": "#/$defs/profile_id" },
        "content": { "type": "string", "minLength": 1, "maxLength": 49152 }
      }
    },
    "result_profile_import": { "$ref": "#/$defs/profile" },

    "params_profile_update": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": {
        "id": { "$ref": "#/$defs/profile_id" },
        "name": { "$ref": "#/$defs/profile_name" },
        "tags": { "$ref": "#/$defs/tags" },
        "color": { "$ref": "#/$defs/color" },
        "scope": { "$ref": "#/$defs/scope" },
        "killswitch": { "$ref": "#/$defs/killswitch" },
        "dns": { "$ref": "#/$defs/dns" }
      }
    },
    "result_profile_update": { "$ref": "#/$defs/profile" },

    "params_profile_delete": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": { "id": { "$ref": "#/$defs/profile_id" } }
    },
    "result_profile_delete": { "$ref": "#/$defs/result_ack" },

    "params_scope_learn_accept": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "cidrs"],
      "properties": {
        "id": { "$ref": "#/$defs/profile_id" },
        "cidrs": { "$ref": "#/$defs/cidr_list" }
      }
    },
    "result_scope_learn_accept": { "$ref": "#/$defs/profile" },

    "params_events_subscribe": { "$ref": "#/$defs/params_empty" },
    "result_events_subscribe": { "$ref": "#/$defs/result_ack" },

    "params_logs": {
      "type": "object",
      "additionalProperties": false,
      "properties": { "since": { "$ref": "#/$defs/timestamp" } }
    },
    "result_logs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["events"],
      "properties": { "events": { "type": "array", "items": { "$ref": "#/$defs/event" } } }
    },

    "method": {
      "enum": ["status", "list", "up", "down", "panic_off", "profile_import", "profile_update", "profile_delete", "scope_learn_accept", "events_subscribe", "logs"]
    },
    "request_id": { "oneOf": [{ "type": "integer" }, { "type": "string", "maxLength": 64 }] },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["jsonrpc", "id", "method"],
      "properties": {
        "jsonrpc": { "const": "2.0" },
        "id": { "$ref": "#/$defs/request_id" },
        "method": { "$ref": "#/$defs/method" },
        "params": true
      },
      "allOf": [
        { "if": { "properties": { "method": { "const": "status" } } }, "then": { "properties": { "params": { "$ref": "#/$defs/params_status" } } } },
        { "if": { "properties": { "method": { "const": "list" } } }, "then": { "properties": { "params": { "$ref": "#/$defs/params_list" } } } },
        { "if": { "properties": { "method": { "const": "up" } } }, "then": { "required": ["params"], "properties": { "params": { "$ref": "#/$defs/params_up" } } } },
        { "if": { "properties": { "method": { "const": "down" } } }, "then": { "properties": { "params": { "$ref": "#/$defs/params_down" } } } },
        { "if": { "properties": { "method": { "const": "panic_off" } } }, "then": { "properties": { "params": { "$ref": "#/$defs/params_panic_off" } } } },
        { "if": { "properties": { "method": { "const": "profile_import" } } }, "then": { "required": ["params"], "properties": { "params": { "$ref": "#/$defs/params_profile_import" } } } },
        { "if": { "properties": { "method": { "const": "profile_update" } } }, "then": { "required": ["params"], "properties": { "params": { "$ref": "#/$defs/params_profile_update" } } } },
        { "if": { "properties": { "method": { "const": "profile_delete" } } }, "then": { "required": ["params"], "properties": { "params": { "$ref": "#/$defs/params_profile_delete" } } } },
        { "if": { "properties": { "method": { "const": "scope_learn_accept" } } }, "then": { "required": ["params"], "properties": { "params": { "$ref": "#/$defs/params_scope_learn_accept" } } } },
        { "if": { "properties": { "method": { "const": "events_subscribe" } } }, "then": { "properties": { "params": { "$ref": "#/$defs/params_events_subscribe" } } } },
        { "if": { "properties": { "method": { "const": "logs" } } }, "then": { "properties": { "params": { "$ref": "#/$defs/params_logs" } } } }
      ]
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": { "$ref": "#/$defs/error_codes" },
        "message": { "type": "string", "maxLength": 1024 },
        "data": { "type": "object" }
      }
    },
    "response": {
      "type": "object",
      "additionalProperties": false,
      "required": ["jsonrpc", "id"],
      "properties": {
        "jsonrpc": { "const": "2.0" },
        "id": { "oneOf": [{ "$ref": "#/$defs/request_id" }, { "type": "null" }] },
        "result": { "type": "object" },
        "error": { "$ref": "#/$defs/error" }
      },
      "oneOf": [{ "required": ["result"] }, { "required": ["error"] }]
    },
    "event_notification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["jsonrpc", "method", "params"],
      "properties": {
        "jsonrpc": { "const": "2.0" },
        "method": { "const": "event" },
        "params": { "$ref": "#/$defs/event" }
      }
    }
  }
}

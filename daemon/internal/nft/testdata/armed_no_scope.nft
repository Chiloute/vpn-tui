table inet vpn_tui {
	chain output {
		type filter hook output priority filter - 10; policy accept;
		oifname "lo" accept
		oifname "tun0" accept
		ip daddr 203.0.113.7 udp dport 51820 accept
		meta nfproto ipv6 drop
		drop
	}
	chain forward {
		type filter hook forward priority filter - 10; policy accept;
		oifname "tun0" accept
		meta nfproto ipv6 drop
		drop
	}
}

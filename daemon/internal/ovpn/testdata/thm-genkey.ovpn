client
dev tun
remote a.example.com 1194
auth-user-pass
<ca>
# issuer chain
-----BEGIN CERTIFICATE-----
AAAA
-----END CERTIFICATE-----
; second
-----BEGIN CERTIFICATE-----
BBBB
-----END CERTIFICATE-----
# trailing
</ca>
<tls-crypt>
#
# 2048 bit OpenVPN static key
#
-----BEGIN OpenVPN Static key V1-----
abcd
-----END OpenVPN Static key V1-----
</tls-crypt>

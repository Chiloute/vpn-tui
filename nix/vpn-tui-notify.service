# Unité systemd UTILISATEUR facultative : notifications de bureau pour vpn-tui.
# @vpn-tui@ est remplacé par le module Nix. Le daemon root n'envoie jamais de notification.
[Unit]
Description=vpn-tui desktop notifications

[Service]
Type=simple
ExecStart=@vpn-tui@/bin/vpn-tui notify
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
